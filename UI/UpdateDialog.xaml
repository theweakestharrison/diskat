<Window x:Class="Diskat.UI.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Diskat.Core"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Margin="18" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" Width="460">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22" Color="#1A2540"/>
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource LogoImage}" Width="40" Height="40"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{core:T UpdTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                    <TextBlock x:Name="MessageText" Foreground="{StaticResource SubText}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="350"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="54,10,0,0">
                <Hyperlink x:Name="NotesLink" Click="Notes_Click"><Run Text="{core:T UpdNotes}"/></Hyperlink>
            </TextBlock>

            <StackPanel x:Name="ProgressPanel" Margin="0,18,0,0" Visibility="Collapsed">
                <ProgressBar x:Name="Progress" Style="{StaticResource SlimBar}" Maximum="1"/>
                <TextBlock x:Name="ProgressText" Margin="0,8,0,0" Foreground="{StaticResource SubText}" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="LaterBtn" Content="{core:T UpdLater}" Style="{StaticResource BaseButton}" MinWidth="90" Height="36"
                        IsCancel="True" Click="Later_Click"/>
                <Button x:Name="UpdateBtn" Content="{core:T UpdNow}" Style="{StaticResource PrimaryButton}" MinWidth="130" Height="36"
                        Margin="10,0,0,0" Padding="16,6" IsDefault="True" Click="Update_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
