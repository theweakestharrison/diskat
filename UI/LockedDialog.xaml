<Window x:Class="Diskat.UI.LockedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Diskat.Core"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Margin="18" Background="White" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" Width="600">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22" Color="#1A2540"/>
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="20" Background="#FFF4DD">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="#C98A00"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{core:T LockTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                    <TextBlock x:Name="SubText" Foreground="{StaticResource SubText}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="480"/>
                </StackPanel>
            </StackPanel>

            <Border Background="#F5F7FA" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                <TextBox x:Name="PathText" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource Text}" MaxHeight="80"/>
            </Border>

            <ItemsControl x:Name="ProcessList" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="2,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{StaticResource SubText}" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SubText}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="NoneText" Text="{core:T LockNone}" Foreground="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>

            <DockPanel Margin="0,18,0,0" LastChildFill="True">
                <Button x:Name="CancelBtn" DockPanel.Dock="Left" Content="{core:T Cancel}" Style="{StaticResource BaseButton}" MinWidth="90" Height="36"
                        Margin="0,0,0,6" VerticalAlignment="Bottom" IsCancel="True" Click="Cancel_Click"/>
                <!-- Nhãn dài (vd. tiếng Đức) thì hai nút này xuống dòng trong nhóm của chúng, vẫn canh phải -->
                <WrapPanel HorizontalAlignment="Right" FlowDirection="RightToLeft">
                    <Button x:Name="CloseBtn" Content="{core:T LockClose}" Style="{StaticResource PrimaryButton}" Height="36"
                            Margin="0,0,0,6" Padding="16,6" IsDefault="True" Click="Close_Click" FlowDirection="LeftToRight"/>
                    <Button x:Name="RebootBtn" Content="{core:T LockReboot}" Style="{StaticResource BaseButton}" Height="36"
                            Margin="0,0,10,6" Padding="14,6" Click="Reboot_Click" FlowDirection="LeftToRight"/>
                </WrapPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
