<Window x:Class="Diskat.UI.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Diskat.Core"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource DialogCard}" Width="500">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBg" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource IconWarnBg}">
                    <Path x:Name="IconPath" Width="18" Height="20" Stretch="Uniform" Stroke="{DynamicResource IconWarn}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M3,6 L21,6 M8,6 L8,4 C8,3.4 8.4,3 9,3 L15,3 C15.6,3 16,3.4 16,4 L16,6 M5,6 L6,20 C6,20.6 6.4,21 7,21 L17,21 C17.6,21 18,20.6 18,20 L19,6 Z"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource SubText}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="390"/>
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource InsetBg}" CornerRadius="8" Padding="12,10" Margin="0,18,0,0">
                <StackPanel>
                    <TextBox x:Name="PathText" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{core:T ConfirmSize}" Foreground="{DynamicResource SubText}"/>
                        <TextBlock x:Name="SizeText" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                        <TextBlock x:Name="DetailText" Foreground="{DynamicResource SubText}" Margin="14,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="InfoBox" Background="{DynamicResource InfoBg}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="InfoText" Foreground="{DynamicResource InfoText}" TextWrapping="Wrap"/>
            </Border>

            <Border x:Name="WarnBox" Background="{DynamicResource WarnBg}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="{core:T ConfirmWarn}"
                           Foreground="{DynamicResource WarnText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelBtn" Content="{core:T Cancel}" Style="{StaticResource BaseButton}" MinWidth="90" Height="36"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="OkBtn" Style="{StaticResource DangerButton}" MinWidth="150" Height="36" Margin="10,0,0,0" Padding="16,6"
                        Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
