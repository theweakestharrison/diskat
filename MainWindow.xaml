<Window x:Class="Diskat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Diskat.UI"
        xmlns:core="clr-namespace:Diskat.Core"
        Title="Diskat"
        Width="1360" Height="840" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Nút mũi tên mở rộng -->
        <Style x:Key="ExpanderBtn" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                            <TextBlock x:Name="glyph" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                       Foreground="{StaticResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="glyph" Property="Text" Value="&#xE70D;"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E3E8F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="TreeMenu">
            <MenuItem Header="{core:T MenuExplorer}" Click="MenuExplorer_Click">
                <MenuItem.Icon><TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{core:T MenuOpen}" Click="MenuOpen_Click"/>
            <MenuItem Header="{core:T MenuCopy}" Click="MenuCopy_Click">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{core:T MenuMap}" Click="MenuMap_Click">
                <MenuItem.Icon><TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{core:T MenuRescan}" Click="MenuRescan_Click">
                <MenuItem.Icon><TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{core:T MenuRecycle}" InputGestureText="Del" Click="MenuRecycle_Click">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Danger}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{core:T MenuDeletePerm}" InputGestureText="Shift+Del" Click="MenuDelete_Click" Foreground="{StaticResource Danger}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Thanh trên cùng ===== -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <!-- Logo Diskat (Themes/Logo.xaml) -->
                    <Image Source="{StaticResource LogoImage}" Width="38" Height="38"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Diskat" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="{core:T AppSubtitle}" FontSize="11.5" Foreground="{StaticResource SubText}"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="PathBox" Style="{StaticResource PathBox}" Height="36" Padding="34,0,8,0" KeyDown="PathBox_KeyDown"
                             ToolTip="{core:T PathTip}"/>
                    <Path Data="{x:Static ui:Icons.Folder}" Fill="#F6C34F" Stroke="#D9961A" StrokeThickness="1" Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="BrowseBtn" Style="{StaticResource BaseButton}" Height="36" Click="Browse_Click" ToolTip="{core:T BrowseTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{core:T Browse}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScanBtn" Style="{StaticResource PrimaryButton}" Height="36" Margin="8,0,0,0" Padding="18,6" Click="Scan_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{core:T Scan}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopBtn" Style="{StaticResource DangerButton}" Height="36" Margin="8,0,0,0" Padding="18,6" Click="Stop_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{core:T Stop}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AdminBtn" Style="{StaticResource GhostButton}" Height="36" Margin="6,0,0,0" Click="Admin_Click"
                            ToolTip="{core:T AdminTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Foreground="#E8A317" Margin="0,0,6,0"/>
                            <TextBlock Text="{core:T Admin}" Foreground="{StaticResource SubText}"/>
                        </StackPanel>
                    </Button>
                    <!-- Chuyển ngôn ngữ EN / VI -->
                    <Border CornerRadius="7" BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="8,0,0,0" Height="32"
                            VerticalAlignment="Center" Padding="2" ToolTip="{core:T LangTip}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LangEnBtn" Content="EN" Tag="en" Click="Lang_Click" Style="{StaticResource GhostButton}" Focusable="False"
                                    Padding="9,2" FontSize="12" FontWeight="SemiBold"/>
                            <Button x:Name="LangViBtn" Content="VI" Tag="vi" Click="Lang_Click" Style="{StaticResource GhostButton}" Focusable="False"
                                    Padding="9,2" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Ổ đĩa ===== -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="16,12,16,0">
            <ItemsControl x:Name="DrivesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource DriveButton}" Tag="{Binding Root}" Click="Drive_Click" Width="210" ToolTip="{Binding Tip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding UsedText}" FontSize="11" Foreground="{StaticResource SubText}" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource SlimBar}" Margin="0,5,0,4" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" Foreground="{Binding BarBrush}"/>
                                    <TextBlock Text="{Binding FreeText}" FontSize="11" Foreground="{StaticResource SubText}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===== Nội dung chính ===== -->
        <Grid Grid.Row="2" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Cây thư mục -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Click="CollapseAll_Click" ToolTip="{core:T CollapseTip}">
                                    <TextBlock Text="{core:T Collapse}" Foreground="{StaticResource SubText}"/>
                                </Button>
                                <Button x:Name="ExplorerBtn" Style="{StaticResource GhostButton}" Click="MenuExplorer_Click" ToolTip="{core:T OpenTip}" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8DA;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{core:T Open}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RecycleBtn" Style="{StaticResource DangerButton}" Click="MenuRecycle_Click" Margin="8,0,0,0" Padding="12,5"
                                        ToolTip="{core:T DeleteTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{core:T Delete}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteBtn" Style="{StaticResource BaseButton}" Click="MenuDelete_Click" Margin="6,0,0,0" Padding="10,5"
                                        ToolTip="{core:T DeletePermTip}">
                                    <TextBlock Text="{core:T DeletePerm}" Foreground="{StaticResource Danger}"/>
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{core:T TreeTitle}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="SelectionText" Text="{core:T NoSelection}" Foreground="{StaticResource SubText}" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ListView x:Name="Tree" Grid.Row="1" Style="{StaticResource FlatList}"
                              SelectionMode="Single"
                              ContextMenu="{StaticResource TreeMenu}"
                              SelectionChanged="Tree_SelectionChanged"
                              MouseDoubleClick="Tree_MouseDoubleClick"
                              PreviewKeyDown="Tree_PreviewKeyDown"
                              GridViewColumnHeader.Click="TreeHeader_Click">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource FlatHeader}">
                                <GridViewColumn Width="330">
                                    <GridViewColumnHeader Content="Name" Tag="name"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" Height="26">
                                                <Grid Width="20">
                                                    <Button x:Name="exp" Style="{StaticResource ExpanderBtn}" Click="Expander_Click"/>
                                                </Grid>
                                                <Path Data="{Binding IconGeometry}" Fill="{Binding IconFill}" Stroke="{Binding IconStroke}" StrokeThickness="1.1"
                                                      Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" Margin="3,0,8,0"
                                                      StrokeLineJoin="Round"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Note}" Foreground="{StaticResource SubText}" FontStyle="Italic" FontSize="11.5"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                    <Setter TargetName="exp" Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="92">
                                    <GridViewColumnHeader Content="Size" Tag="size"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Size}" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,4,0"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="140">
                                    <GridViewColumnHeader Content="% of parent" Tag="pct"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ProgressBar Style="{StaticResource SlimBar}" Width="78" Height="8" Maximum="100"
                                                             Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding BarBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PercentText}" Foreground="{StaticResource SubText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="72">
                                    <GridViewColumnHeader Content="Files" Tag="files"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Files}" TextAlignment="Right" Foreground="{StaticResource SubText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="72">
                                    <GridViewColumnHeader Content="Folders" Tag="dirs"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Folders}" TextAlignment="Right" Foreground="{StaticResource SubText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="136">
                                    <GridViewColumnHeader Content="Modified" Tag="date"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Modified}" Foreground="{StaticResource SubText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Trạng thái trống -->
                    <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="&#xEC50;" FontFamily="{StaticResource IconFont}" FontSize="54" Foreground="#C9D3E3" HorizontalAlignment="Center"/>
                        <TextBlock Text="{core:T EmptyTitle}" FontSize="15" Foreground="{StaticResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,14,0,4"/>
                        <TextBlock Text="{core:T EmptySub}" FontSize="12" Foreground="#9AA0AB" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- Bên phải: bản đồ + file lớn nhất -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TabControl x:Name="RightTabs" Style="{StaticResource FlatTabControl}">
                    <TabItem Header="{core:T TabMap}">
                        <Grid Margin="12,10,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="MapUpBtn" DockPanel.Dock="Left" Style="{StaticResource BaseButton}" Padding="8,4" Click="MapUp_Click" ToolTip="{core:T MapUpTip}">
                                    <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}"/>
                                </Button>
                                <TextBlock x:Name="MapSize" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock x:Name="MapTitle" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource SubText}"/>
                            </DockPanel>
                            <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Background="#F6F8FB">
                                <ui:TreemapControl x:Name="Map" Cursor="Hand" ContextMenu="{StaticResource TreeMenu}"/>
                            </Border>
                            <TextBlock x:Name="MapHover" Grid.Row="2" Margin="2,8,0,0" Foreground="{StaticResource SubText}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" Text="{core:T MapHint}"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{core:T TabTopFiles}">
                        <ListView x:Name="TopFiles" Style="{StaticResource FlatList}" SelectionMode="Extended" Margin="0,0,0,4"
                                  MouseDoubleClick="TopFiles_MouseDoubleClick" PreviewKeyDown="TopFiles_PreviewKeyDown">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{core:T MenuShowInExplorer}" Click="TopExplorer_Click"/>
                                    <MenuItem Header="{core:T MenuOpen}" Click="TopOpen_Click"/>
                                    <MenuItem Header="{core:T MenuCopy}" Click="TopCopy_Click"/>
                                    <Separator/>
                                    <MenuItem Header="{core:T MenuRecycle}" InputGestureText="Del" Click="TopRecycle_Click"/>
                                    <MenuItem Header="{core:T MenuDeletePerm}" InputGestureText="Shift+Del" Click="TopDelete_Click" Foreground="{StaticResource Danger}"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource FlatHeader}">
                                    <GridViewColumn Header="{core:T ColFileName}" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Height="26">
                                                    <Path Data="{x:Static ui:Icons.File}" Fill="#EAF1FD" Stroke="#5B8DEF" StrokeThickness="1.1" Width="16" Height="16"
                                                          Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{core:T ColSize}" Width="88">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{core:T ColFolder}" Width="260" DisplayMemberBinding="{Binding Folder}"/>
                                    <GridViewColumn Header="{core:T ColModified}" Width="120" DisplayMemberBinding="{Binding Modified}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ===== Thanh trạng thái ===== -->
        <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="ScanProgress" Style="{StaticResource SlimBar}" Width="120" IsIndeterminate="False" Visibility="Collapsed"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="{core:T Ready}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SubText}"/>
                <TextBlock x:Name="StatsText" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource Text}" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Lớp phủ khi đang xóa -->
        <Grid x:Name="BusyOverlay" Grid.RowSpan="4" Background="#80F3F5F9" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="BusyText" Text="{core:T Deleting}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <ProgressBar Style="{StaticResource SlimBar}" IsIndeterminate="True" Width="240" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
