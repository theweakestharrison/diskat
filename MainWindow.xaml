<Window x:Class="Diskat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Diskat.UI"
        xmlns:core="clr-namespace:Diskat.Core"
        Title="Diskat"
        Width="1360" Height="840" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Nút mũi tên mở rộng -->
        <Style x:Key="ExpanderBtn" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                            <TextBlock x:Name="glyph" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                       Foreground="{DynamicResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="glyph" Property="Text" Value="&#xE70D;"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ExpanderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="TreeMenu">
            <MenuItem Header="{core:T MenuExplorer}" Click="MenuExplorer_Click">
                <MenuItem.Icon><TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{core:T MenuOpen}" Click="MenuOpen_Click"/>
            <MenuItem Header="{core:T MenuCopy}" Click="MenuCopy_Click">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{core:T MenuMap}" Click="MenuMap_Click">
                <MenuItem.Icon><TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{core:T MenuRescan}" Click="MenuRescan_Click">
                <MenuItem.Icon><TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{core:T MenuRecycle}" InputGestureText="Del" Click="MenuRecycle_Click">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource DangerText}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{core:T MenuDeletePerm}" InputGestureText="Shift+Del" Click="MenuDelete_Click" Foreground="{DynamicResource DangerText}"/>
        </ContextMenu>

        <!-- Cột "Thay đổi": chỉ có trong lưới cây khi đang so sánh với một lần quét đã lưu (MainWindow.Compare.cs) -->
        <GridViewColumn x:Key="ChangeColumn" Width="96">
            <GridViewColumnHeader Content="Change" Tag="change"/>
            <GridViewColumn.CellTemplate>
                <DataTemplate>
                    <TextBlock x:Name="chg" Text="{Binding ChangeText}" ToolTip="{Binding ChangeTip}" FontWeight="SemiBold" TextAlignment="Right"
                               Margin="0,0,4,0" Foreground="{DynamicResource SubText}"/>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding ChangeSign}" Value="1">
                            <Setter TargetName="chg" Property="Foreground" Value="{DynamicResource GrowText}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ChangeSign}" Value="-1">
                            <Setter TargetName="chg" Property="Foreground" Value="{DynamicResource ShrinkText}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </GridViewColumn.CellTemplate>
        </GridViewColumn>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Thanh trên cùng ===== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <!-- Logo Diskat (Themes/Logo.xaml) -->
                    <Image Source="{StaticResource LogoImage}" Width="38" Height="38"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Diskat" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="{core:T AppSubtitle}" FontSize="11.5" Foreground="{DynamicResource SubText}"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="PathBox" Style="{StaticResource PathBox}" Height="36" Padding="34,0,8,0" KeyDown="PathBox_KeyDown"
                             ToolTip="{core:T PathTip}"/>
                    <Path Data="{x:Static ui:Icons.Folder}" Fill="{DynamicResource FolderFill}" Stroke="{DynamicResource FolderStroke}" StrokeThickness="1" Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="BrowseBtn" Style="{StaticResource BaseButton}" Height="36" Click="Browse_Click" ToolTip="{core:T BrowseTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{core:T Browse}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScanBtn" Style="{StaticResource PrimaryButton}" Height="36" Margin="8,0,0,0" Padding="18,6" Click="Scan_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{core:T Scan}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopBtn" Style="{StaticResource DangerButton}" Height="36" Margin="8,0,0,0" Padding="18,6" Click="Stop_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{core:T Stop}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AdminBtn" Style="{StaticResource GhostButton}" Height="36" Margin="6,0,0,0" Click="Admin_Click"
                            ToolTip="{core:T AdminTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Foreground="{DynamicResource IconWarn}" Margin="0,0,6,0"/>
                            <TextBlock Text="{core:T Admin}" Foreground="{DynamicResource SubText}"/>
                        </StackPanel>
                    </Button>
                    <!-- Chọn ngôn ngữ: menu thả xuống, danh sách lấy từ Loc.Languages -->
                    <Button x:Name="LangBtn" Style="{StaticResource BaseButton}" Height="34" Margin="8,0,0,0" Padding="10,4"
                            Focusable="False" Click="LangBtn_Click" ToolTip="{core:T LangTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Foreground="{DynamicResource AccentText}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="LangLabel" Text="VI" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource SubText}" Margin="7,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <!-- Menu "Thêm": báo cáo PDF, cập nhật, giới thiệu -->
                    <Button x:Name="MoreBtn" Style="{StaticResource GhostButton}" Height="34" Margin="4,0,0,0" Padding="9,4"
                            Focusable="False" Click="MoreBtn_Click" ToolTip="{core:T MenuMore}">
                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Ổ đĩa ===== -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="16,12,16,0">
            <ItemsControl x:Name="DrivesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource DriveButton}" Tag="{Binding Root}" Click="Drive_Click" Width="210" ToolTip="{Binding Tip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource AccentText}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding UsedText}" FontSize="11" Foreground="{DynamicResource SubText}" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource SlimBar}" Margin="0,5,0,4" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" Foreground="{Binding BarBrush}"/>
                                    <TextBlock Text="{Binding FreeText}" FontSize="11" Foreground="{DynamicResource SubText}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===== Nội dung chính ===== -->
        <Grid Grid.Row="2" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Cây thư mục -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
                        <DockPanel>
                            <!-- Đang so sánh với một lần quét đã lưu: tóm tắt thay đổi và nút tắt (MainWindow.Compare.cs) -->
                            <Border x:Name="CompareBar" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,5,4,5"
                                    Background="{DynamicResource AccentSoft}" CornerRadius="6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="StopCompare_Click" Padding="8,3"
                                            VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{core:T CompareStop}" Foreground="{DynamicResource AccentText}"/>
                                    </Button>
                                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentText}"
                                               VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="CompareText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="CompareNote" Foreground="{DynamicResource SubText}" FontSize="11.5" TextWrapping="Wrap"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Click="CollapseAll_Click" ToolTip="{core:T CollapseTip}">
                                    <TextBlock Text="{core:T Collapse}" Foreground="{DynamicResource SubText}"/>
                                </Button>
                                <Button x:Name="ExplorerBtn" Style="{StaticResource GhostButton}" Click="MenuExplorer_Click" ToolTip="{core:T OpenTip}" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8DA;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{core:T Open}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RecycleBtn" Style="{StaticResource DangerButton}" Click="MenuRecycle_Click" Margin="8,0,0,0" Padding="12,5"
                                        ToolTip="{core:T DeleteTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{core:T Delete}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteBtn" Style="{StaticResource BaseButton}" Click="MenuDelete_Click" Margin="6,0,0,0" Padding="10,5"
                                        ToolTip="{core:T DeletePermTip}">
                                    <TextBlock Text="{core:T DeletePerm}" Foreground="{DynamicResource DangerText}"/>
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{core:T TreeTitle}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="SelectionText" Text="{core:T NoSelection}" Foreground="{DynamicResource SubText}" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ListView x:Name="Tree" Grid.Row="1" Style="{StaticResource FlatList}"
                              SelectionMode="Single"
                              ContextMenu="{StaticResource TreeMenu}"
                              SelectionChanged="Tree_SelectionChanged"
                              MouseDoubleClick="Tree_MouseDoubleClick"
                              PreviewKeyDown="Tree_PreviewKeyDown"
                              GridViewColumnHeader.Click="TreeHeader_Click">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource FlatHeader}">
                                <GridViewColumn Width="330">
                                    <GridViewColumnHeader Content="Name" Tag="name"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" Height="26">
                                                <Grid Width="20">
                                                    <Button x:Name="exp" Style="{StaticResource ExpanderBtn}" Click="Expander_Click"/>
                                                </Grid>
                                                <Path Data="{Binding IconGeometry}" Fill="{Binding IconFill}" Stroke="{Binding IconStroke}" StrokeThickness="1.1"
                                                      Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" Margin="3,0,8,0"
                                                      StrokeLineJoin="Round"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <!-- Thư mục chưa có trong lần quét đang so sánh -->
                                                <Border Visibility="{Binding NewVisibility}" Background="{DynamicResource AccentSoft}" CornerRadius="3"
                                                        Padding="5,0,5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NewLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource SubText}" FontStyle="Italic" FontSize="11.5"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                    <Setter TargetName="exp" Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="92">
                                    <GridViewColumnHeader Content="Size" Tag="size"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Size}" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,4,0"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="140">
                                    <GridViewColumnHeader Content="% of parent" Tag="pct"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ProgressBar Style="{StaticResource SlimBar}" Width="78" Height="8" Maximum="100"
                                                             Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding BarBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource SubText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="72">
                                    <GridViewColumnHeader Content="Files" Tag="files"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Files}" TextAlignment="Right" Foreground="{DynamicResource SubText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="72">
                                    <GridViewColumnHeader Content="Folders" Tag="dirs"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Folders}" TextAlignment="Right" Foreground="{DynamicResource SubText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="136">
                                    <GridViewColumnHeader Content="Modified" Tag="date"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Modified}" Foreground="{DynamicResource SubText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Trạng thái trống -->
                    <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="&#xEC50;" FontFamily="{StaticResource IconFont}" FontSize="54" Foreground="{DynamicResource EmptyIcon}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{core:T EmptyTitle}" FontSize="15" Foreground="{DynamicResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,14,0,4"/>
                        <TextBlock Text="{core:T EmptySub}" FontSize="12" Foreground="{DynamicResource HintText}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- Bên phải: bản đồ + file lớn nhất -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TabControl x:Name="RightTabs" Style="{StaticResource FlatTabControl}">
                    <TabItem Header="{core:T TabMap}">
                        <Grid Margin="12,10,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="MapUpBtn" DockPanel.Dock="Left" Style="{StaticResource BaseButton}" Padding="8,4" Click="MapUp_Click" ToolTip="{core:T MapUpTip}">
                                    <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}"/>
                                </Button>
                                <TextBlock x:Name="MapSize" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock x:Name="MapTitle" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SubText}"/>
                            </DockPanel>
                            <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource MapBg}">
                                <ui:TreemapControl x:Name="Map" Cursor="Hand" ContextMenu="{StaticResource TreeMenu}"/>
                            </Border>
                            <TextBlock x:Name="MapHover" Grid.Row="2" Margin="2,8,0,0" Foreground="{DynamicResource SubText}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" Text="{core:T MapHint}"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="TopFilesTab" Header="{core:T TabTopFiles}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tìm file theo tên / dung lượng / tuổi trong toàn bộ thư mục đã quét -->
                            <!-- Ô tìm co giãn theo chỗ còn lại; hai bộ lọc và nút giữ độ rộng vừa chữ -->
                            <Grid Margin="10,10,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Height="30" Margin="0,0,6,0">
                                    <TextBox x:Name="FindText" Style="{StaticResource PathBox}" Padding="28,0,6,0" FontSize="12.5"
                                             TextChanged="FindText_TextChanged" KeyDown="FindText_KeyDown" ToolTip="{core:T FindNameTip}"/>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource SubText}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="FindTextHint" Text="{core:T FindNameHint}" FontSize="12.5" Foreground="{DynamicResource HintText}"
                                               VerticalAlignment="Center" Margin="30,0,6,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <ComboBox x:Name="FindSize" Grid.Column="1" Height="30" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                <ComboBox x:Name="FindAge" Grid.Column="2" Height="30" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                <Button x:Name="FindBtn" Grid.Column="3" Style="{StaticResource PrimaryButton}" Height="30" Padding="14,4"
                                        Click="FindSearch_Click" Content="{core:T FindSearch}"/>
                            </Grid>
                            <DockPanel Grid.Row="1" Margin="12,0,8,6">
                                <Button x:Name="FindClearBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="12"
                                        Foreground="{DynamicResource AccentText}" Click="FindClear_Click" Content="{core:T FindClear}" Visibility="Collapsed"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="FindInfo" FontSize="12" Foreground="{DynamicResource SubText}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Text="{core:T FindTopHint}"/>
                            </DockPanel>
                        <ListView x:Name="TopFiles" Grid.Row="2" Style="{StaticResource FlatList}" SelectionMode="Extended" Margin="0,0,0,4"
                                  MouseDoubleClick="TopFiles_MouseDoubleClick" PreviewKeyDown="TopFiles_PreviewKeyDown">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{core:T MenuShowInExplorer}" Click="TopExplorer_Click"/>
                                    <MenuItem Header="{core:T MenuOpen}" Click="TopOpen_Click"/>
                                    <MenuItem Header="{core:T MenuCopy}" Click="TopCopy_Click"/>
                                    <Separator/>
                                    <MenuItem Header="{core:T MenuRecycle}" InputGestureText="Del" Click="TopRecycle_Click"/>
                                    <MenuItem Header="{core:T MenuDeletePerm}" InputGestureText="Shift+Del" Click="TopDelete_Click" Foreground="{DynamicResource DangerText}"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource FlatHeader}">
                                    <GridViewColumn Header="{core:T ColFileName}" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Height="26">
                                                    <Path Data="{x:Static ui:Icons.File}" Fill="{DynamicResource FileFill}" Stroke="{DynamicResource FileStroke}" StrokeThickness="1.1" Width="16" Height="16"
                                                          Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{core:T ColSize}" Width="88">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{core:T ColFolder}" Width="260" DisplayMemberBinding="{Binding Folder}"/>
                                    <GridViewColumn Header="{core:T ColModified}" Width="120" DisplayMemberBinding="{Binding Modified}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        </Grid>
                    </TabItem>

                    <!-- Loại file: tổng theo phần mở rộng trong lần quét -->
                    <TabItem Header="{core:T TabTypes}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TypesNote" Margin="12,10,12,6" FontSize="12" Foreground="{DynamicResource SubText}" TextWrapping="Wrap"/>
                            <ListView x:Name="TypesList" Grid.Row="1" Style="{StaticResource FlatList}" Margin="0,0,0,4"
                                      MouseDoubleClick="TypesList_MouseDoubleClick">
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{core:T MenuFindType}" Click="FindType_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource FlatHeader}">
                                        <GridViewColumn Header="{core:T ColType}" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Height="26">
                                                        <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Swatch}" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{core:T ColShare}" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ProgressBar Style="{StaticResource SlimBar}" Width="78" Height="8" Maximum="100"
                                                                     Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Swatch}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource SubText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{core:T ColSize}" Width="88">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" TextAlignment="Right"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{core:T ColFiles}" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FilesText}" Foreground="{DynamicResource SubText}" TextAlignment="Right"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <!-- Tuổi file: theo lần sửa cuối -->
                    <TabItem Header="{core:T TabAges}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="AgesNote" Margin="12,10,12,8" FontSize="12" Foreground="{DynamicResource SubText}" TextWrapping="Wrap"/>
                            <!-- Thanh xếp chồng: tỷ lệ từng nhóm tuổi -->
                            <Border Grid.Row="1" Margin="12,0,12,8" Height="14" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource Track}">
                                <Grid x:Name="AgesStrip"/>
                            </Border>
                            <ListView x:Name="AgesList" Grid.Row="2" Style="{StaticResource FlatList}" Margin="0,0,0,4"
                                      MouseDoubleClick="AgesList_MouseDoubleClick">
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{core:T MenuFindOlder}" Click="FindOlder_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource FlatHeader}">
                                        <GridViewColumn Header="{core:T ColModified}" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Height="26">
                                                        <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Swatch}" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{core:T ColShare}" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ProgressBar Style="{StaticResource SlimBar}" Width="78" Height="8" Maximum="100"
                                                                     Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Swatch}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource SubText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{core:T ColSize}" Width="88">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" TextAlignment="Right"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{core:T ColFiles}" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FilesText}" Foreground="{DynamicResource SubText}" TextAlignment="Right"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <!-- Trùng lặp: file giống hệt nhau (UI/DuplicatesView.xaml, MainWindow.Duplicates.cs) -->
                    <TabItem x:Name="DupTab" Header="{core:T TabDuplicates}">
                        <ui:DuplicatesView x:Name="DupView"/>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ===== Thanh trạng thái ===== -->
        <Border Grid.Row="3" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="ScanProgress" Style="{StaticResource SlimBar}" Width="120" IsIndeterminate="False" Visibility="Collapsed"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="{core:T Ready}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubText}"/>
                <TextBlock x:Name="StatsText" Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource Text}" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Lớp phủ khi đang xóa -->
        <Grid x:Name="BusyOverlay" Grid.RowSpan="4" Background="{DynamicResource Overlay}" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="BusyText" Text="{core:T Deleting}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <ProgressBar Style="{StaticResource SlimBar}" IsIndeterminate="True" Width="240" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
