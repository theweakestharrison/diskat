{
  // diskat.cc: static site in ./website plus a small Worker (worker/index.js) that serves the
  // downloads from the R2 bucket "diskat-downloads": Diskat.exe at /download, the macOS DMG at /download/mac.
  // Deploy: npx wrangler deploy   (the diskat.cc zone must be in the same Cloudflare account)
  "name": "diskat-website",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/download", "/download/*"]
  },
  "r2_buckets": [
    { "binding": "DOWNLOADS", "bucket_name": "diskat-downloads" }
  ],
  "vars": {
    // Windows version that /download points to. Upload releases/v<version>/Diskat.exe to R2 first.
    "LATEST_VERSION": "1.0.0",
    // macOS version that /download/mac points to (versioned separately from Windows).
    // Upload releases/v<version>/Diskat-<version>.dmg to R2 first.
    "LATEST_MAC_VERSION": "1.0.0"
  },
  "routes": [
    { "pattern": "diskat.cc", "custom_domain": true }
  ]
}
