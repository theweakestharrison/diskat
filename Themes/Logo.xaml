<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Logo Diskat: mặt mèo là một biểu đồ vành khuyên (donut chart):
        phần vàng = dung lượng đã dùng, phần trắng = còn trống.
        Hệ tọa độ 36 x 36; dùng chung cho header và để sinh app.ico.
    -->

    <PathGeometry x:Key="LogoHead"
                  Figures="M7.2,22 C7.2,18.6 8.2,15.9 9.6,14.1 L8.9,6.4 C8.85,5.6 9.6,5.2 10.2,5.6 L16,9.9 C16.65,9.8 17.3,9.75 18,9.75 C18.7,9.75 19.35,9.8 20,9.9 L25.8,5.6 C26.4,5.2 27.15,5.6 27.1,6.4 L26.4,14.1 C27.8,15.9 28.8,18.6 28.8,22 C28.8,27.6 24,31 18,31 C12,31 7.2,27.6 7.2,22 Z"/>
    <EllipseGeometry x:Key="LogoFace" Center="18,21.6" RadiusX="6.6" RadiusY="5.9"/>
    <!-- Lát "đã dùng": từ đỉnh đầu theo chiều kim đồng hồ tới góc dưới phải (gồm cả tai phải) -->
    <PathGeometry x:Key="LogoUsedWedge" Figures="M18,21.6 L18.6,0 L40,0 L40,30 L33,30.5 Z"/>
    <!-- Khe hở mảnh giữa hai lát, giống biểu đồ thật -->
    <GeometryGroup x:Key="LogoGaps">
        <PathGeometry Figures="M17.45,21.6 L18.05,0 L19.15,0 L18.55,21.6 Z"/>
        <PathGeometry Figures="M17.72,22.07 L32.72,30.97 L33.28,30.03 L18.28,21.13 Z"/>
    </GeometryGroup>

    <CombinedGeometry x:Key="LogoRing" GeometryCombineMode="Exclude"
                      Geometry1="{StaticResource LogoHead}" Geometry2="{StaticResource LogoFace}"/>

    <DrawingImage x:Key="LogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Nền bo góc -->
                <GeometryDrawing Geometry="M9,0 L27,0 A9,9 0 0 1 36,9 L36,27 A9,9 0 0 1 27,36 L9,36 A9,9 0 0 1 0,27 L0,9 A9,9 0 0 1 9,0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#5B8CFF" Offset="0"/>
                            <GradientStop Color="#2E4FD8" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>

                <!-- Phần còn trống (trắng) -->
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <CombinedGeometry GeometryCombineMode="Exclude" Geometry2="{StaticResource LogoGaps}">
                            <CombinedGeometry.Geometry1>
                                <CombinedGeometry GeometryCombineMode="Exclude"
                                                  Geometry1="{StaticResource LogoRing}" Geometry2="{StaticResource LogoUsedWedge}"/>
                            </CombinedGeometry.Geometry1>
                        </CombinedGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Phần đã dùng (vàng) -->
                <GeometryDrawing Brush="#FFB938">
                    <GeometryDrawing.Geometry>
                        <CombinedGeometry GeometryCombineMode="Exclude" Geometry2="{StaticResource LogoGaps}">
                            <CombinedGeometry.Geometry1>
                                <CombinedGeometry GeometryCombineMode="Intersect"
                                                  Geometry1="{StaticResource LogoRing}" Geometry2="{StaticResource LogoUsedWedge}"/>
                            </CombinedGeometry.Geometry1>
                        </CombinedGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Mắt -->
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="15.4,21.3" RadiusX="1.25" RadiusY="1.6"/>
                            <EllipseGeometry Center="20.6,21.3" RadiusX="1.25" RadiusY="1.6"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Mũi -->
                <GeometryDrawing Brush="#FF9AA8" Geometry="M17.1,23.6 L18.9,23.6 L18,24.6 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
