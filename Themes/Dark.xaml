<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Màu giao diện tối: cùng khóa với Light.xaml. Nền xám xanh đậm (không đen tuyền) để đỡ chói,
        màu nhấn giữ nguyên #2F6FED cho nút (chữ trắng 4.5:1), chữ màu nhấn dùng xanh sáng hơn.
    -->

    <Color x:Key="AccentColor">#2F6FED</Color>
    <SolidColorBrush x:Key="Accent" Color="#2F6FED"/>
    <SolidColorBrush x:Key="AccentHover" Color="#2563E0"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1E2A44"/>
    <SolidColorBrush x:Key="AccentText" Color="#6EA0FF"/>

    <SolidColorBrush x:Key="WindowBg" Color="#16181D"/>
    <SolidColorBrush x:Key="CardBg" Color="#1F2229"/>
    <SolidColorBrush x:Key="Border" Color="#2E333D"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#4A5262"/>
    <SolidColorBrush x:Key="Overlay" Color="#9916181D"/>

    <SolidColorBrush x:Key="Text" Color="#E6E9EF"/>
    <SolidColorBrush x:Key="SubText" Color="#A0A7B4"/>
    <SolidColorBrush x:Key="HintText" Color="#8C93A0"/>

    <SolidColorBrush x:Key="RowHover" Color="#262B34"/>
    <SolidColorBrush x:Key="RowSelected" Color="#233456"/>
    <SolidColorBrush x:Key="Track" Color="#2A2F38"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#2A2F39"/>
    <SolidColorBrush x:Key="ButtonPressed" Color="#333946"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#23272F"/>
    <SolidColorBrush x:Key="HeaderHover" Color="#2A2F39"/>
    <SolidColorBrush x:Key="ExpanderHover" Color="#2E3440"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#474D59"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#5F6676"/>

    <SolidColorBrush x:Key="Danger" Color="#D93B3B"/>
    <SolidColorBrush x:Key="DangerHover" Color="#BF2F2F"/>
    <SolidColorBrush x:Key="DangerText" Color="#FF7A7A"/>

    <SolidColorBrush x:Key="MenuBg" Color="#262A32"/>
    <SolidColorBrush x:Key="MenuBorder" Color="#363B46"/>
    <SolidColorBrush x:Key="MenuHover" Color="#313744"/>
    <SolidColorBrush x:Key="ToolTipBg" Color="#2B303A"/>
    <SolidColorBrush x:Key="ToolTipBorder" Color="#3A404C"/>
    <SolidColorBrush x:Key="ToolTipText" Color="#E6E9EF"/>
    <SolidColorBrush x:Key="DialogBg" Color="#22262E"/>
    <Color x:Key="ShadowColor">#000000</Color>
    <SolidColorBrush x:Key="InsetBg" Color="#1A1D23"/>
    <SolidColorBrush x:Key="InfoBg" Color="#3A2E12"/>
    <SolidColorBrush x:Key="InfoText" Color="#F2C46B"/>
    <SolidColorBrush x:Key="WarnBg" Color="#3D1F22"/>
    <SolidColorBrush x:Key="WarnText" Color="#FF8A8A"/>
    <SolidColorBrush x:Key="IconWarnBg" Color="#3A2E12"/>
    <SolidColorBrush x:Key="IconWarn" Color="#F2B33D"/>
    <SolidColorBrush x:Key="IconLock" Color="#F2B33D"/>

    <SolidColorBrush x:Key="FolderFill" Color="#E8B54A"/>
    <SolidColorBrush x:Key="FolderStroke" Color="#B98420"/>
    <SolidColorBrush x:Key="FileFill" Color="#253A5F"/>
    <SolidColorBrush x:Key="FileStroke" Color="#7AA5F7"/>
    <SolidColorBrush x:Key="IconMuted" Color="#7D8594"/>
    <SolidColorBrush x:Key="IconMutedSoft" Color="#3A404B"/>
    <SolidColorBrush x:Key="IconDangerSoft" Color="#5A2A2E"/>

    <SolidColorBrush x:Key="GrowText" Color="#FF8A5C"/>
    <SolidColorBrush x:Key="ShrinkText" Color="#5BD68A"/>

    <SolidColorBrush x:Key="EmptyIcon" Color="#3A4150"/>
    <SolidColorBrush x:Key="MapBg" Color="#181B21"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1F2229"/>

</ResourceDictionary>
